# .env.example
# Example environment variables for local development and Vercel.
# DO NOT commit real secrets into the repository.

# Public site URL (used when generating sitemap)
SITE_URL=https://your-domain.example

# SUPABASE (only if you use Supabase for content/forms)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Analytics (optional)
# VITE_GA_MEASUREMENT_ID=

# Error reporting (optional)
# SENTRY_DSN=

# Other service keys (maps, SMTP, etc.)
# VITE_MAPS_KEY=
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
